    },
    "All Displays" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все дисплеи"
          }
        }
      }
    },
    "An account restriction, such as a blank password, prevents this sign-in." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход невозможен из-за ограничения учётной записи, например пустого пароля."
          }
        }
      }
    },
    "An administrator disconnected the session." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Администратор отключил сеанс."
