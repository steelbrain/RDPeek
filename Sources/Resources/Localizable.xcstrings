    "Reopening RDPeek disconnects any open sessions and closes any PC being edited without saving it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al volver a abrir RDPeek se desconectan las sesiones abiertas y se cierra sin guardar cualquier PC que se esté editando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réouverture de RDPeek déconnecte les sessions ouvertes et ferme sans l’enregistrer tout PC en cours de modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riapertura di RDPeek disconnette le sessioni aperte e chiude senza salvarli i PC in fase di modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
