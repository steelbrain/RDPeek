          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC"
          }
        },
        "pt-BR" : {
