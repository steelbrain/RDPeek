    "The remote computer has no certificate for a secure connection." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У удалённого компьютера нет сертификата для защищённого подключения."
          }
        }
      }
    },
    "The remote computer is restarting." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер перезагружается."
          }
        }
      }
    },
    "The remote computer is shutting down." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер выключается."
          }
        }
      }
    },
    "The remote computer only allows Standard RDP Security, which RDPeek does not support." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер разрешает только Standard RDP Security, которую RDPeek не поддерживает."
          }
        }
      }
    },
    "The remote computer ran out of memory." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На удалённом компьютере закончилась память."
          }
        }
      }
    },
    "The remote computer refused the connection." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер отклонил подключение."
          }
        }
      }
    },
    "The remote computer refused the security RDPeek offered." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер отклонил параметры безопасности, предложенные RDPeek."
          }
        }
      }
    },
    "The remote computer refused the sign-in it passed the session on with." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер отклонил вход, с которым ему передали сеанс."
          }
        }
      }
    },
    "The remote computer rejected something RDPeek sent." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер отклонил данные, отправленные RDPeek."
          }
        }
      }
    },
    "The remote computer rejected the sign-in (status 0x%@)." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер отклонил вход (статус 0x%@)."
          }
        }
      }
    },
    "The remote computer requires a client certificate, which RDPeek does not support." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер требует клиентский сертификат, который RDPeek не поддерживает."
          }
        }
      }
    },
    "The remote computer requires a user name and password." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер требует имя пользователя и пароль."
          }
        }
      }
    },
    "The remote computer requires you to sign in again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер требует повторного входа."
          }
        }
      }
    },
    "The remote computer sent something RDPeek cannot handle." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер прислал данные, которые RDPeek не может обработать."
          }
        }
      }
    },
    "The remote computer signs in with CredSSP %lld, an outdated version of Network Level Authentication that someone intercepting the connection could misuse to learn your sign-in. No password was sent." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый компьютер выполняет вход через CredSSP %lld — устаревшую версию Network Level Authentication, которой может воспользоваться тот, кто перехватывает подключение, чтобы узнать ваши данные для входа. Пароль не отправлялся."
          }
        }
      }
    },
    "The remote session ended before showing the desktop." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый сеанс завершился, не показав рабочий стол."
          }
        }
      }
    },
    "The remote session ended." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалённый сеанс завершён."
          }
        }
      }
    },
    "The saved PC list can't be read by this version of RDPeek and is kept unchanged." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта версия RDPeek не может прочитать список сохранённых ПК, он оставлен без изменений."
          }
        }
      }
    },
    "The saved PC list could not be read, so it was left unchanged." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать список сохранённых ПК, поэтому он оставлен без изменений."
          }
        }
      }
    },
    "The server's certificate is not the one trusted for this host." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертификат сервера не совпадает с тем, которому доверяли для этого хоста."
          }
        }
      }
    },
    "The session ended because of an error on the remote computer." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс завершён из-за ошибки на удалённом компьютере."
          }
        }
      }
    },
    "The session reached its time limit." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс достиг ограничения по времени."
          }
        }
      }
    },
    "The session was disconnected after being idle too long." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс отключён из-за долгого бездействия."
          }
        }
      }
    },
    "The session was disconnected from the remote computer." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс отключён от удалённого компьютера."
          }
        }
      }
    },
    "The user name is too long to send." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя пользователя слишком длинное для отправки."
          }
        }
      }
    },
    "The user name or password is incorrect." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Неверное имя пользователя или пароль."
          }
        }
      }
    },
    "The ⋯ menu in the titlebar holds Disconnect, clipboard sharing (for the session or for %lld seconds, and Sync Now to send a copy the remote doesn't have yet), remote audio, window size matching, the performance overlay, and Stats for Nerds. While the remote desktop has your keyboard, RDPeek's own ⌘ shortcuts go to it too, so use this menu or the Session menu in the menu bar instead." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В меню «⋯» в заголовке окна находятся: «Отключиться», общий буфер обмена (на сеанс или на %lld с, а также «Синхронизировать», чтобы отправить копию, которой ещё нет на удалённом ПК), звук удалённого ПК, подстройка под размер окна, индикатор производительности и «Статистика для гиков». Пока клавиатура передана удалённому рабочему столу, ему отправляются и собственные сочетания клавиш RDPeek с ⌘, поэтому пользуйтесь этим меню или меню «Сеанс» в строке меню."
          }
        }
      }
    },
    "These apply to PCs you add from now on. Existing PCs keep their own settings." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они применяются к ПК, которые вы добавите позже. У существующих ПК остаются свои настройки."
          }
        }
      }
    },
    "This Mac does not trust the server's certificate. Trust it only if you expect it, such as a server's self-signed certificate." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac не доверяет сертификату сервера. Доверяйте ему, только если ожидаете этого, например в случае самоподписанного сертификата сервера."
          }
        }
      }
    },
    "This Mac has no route to “%@”. Check your network connection or VPN." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этого Mac нет маршрута к «%@». Проверьте подключение к сети или VPN."
          }
        }
      }
    },
    "This account has expired." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок действия этой учётной записи истёк."
          }
        }
      }
    },
    "This account is disabled." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта учётная запись отключена."
          }
        }
      }
    },
    "This account is locked out." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта учётная запись заблокирована."
          }
        }
      }
    },
    "This account is not allowed to connect to the remote computer." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этой учётной записи не разрешено подключаться к удалённому компьютеру."
          }
        }
      }
    },
    "This account is not allowed to sign in at this time." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этой учётной записи не разрешён вход в это время."
          }
        }
      }
    },
    "This account is not allowed to sign in from this Mac." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этой учётной записи не разрешён вход с этого Mac."
          }
        }
      }
    },
    "This account is not allowed to sign in with Remote Desktop." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этой учётной записи не разрешён вход через удалённый рабочий стол."
          }
        }
      }
    },
    "Transient network failures — like the first-time local-network permission prompt — retry automatically. Connecting to a PC that already has a session focuses its window, and connects again if that session ended. Changes saved to a PC apply to its open window from the next connection." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Временные сбои сети — например, при первом запросе разрешения для локальной сети — устраняются повторными попытками автоматически. Если подключиться к ПК, у которого уже есть сеанс, откроется его окно, а если сеанс завершён, подключение будет выполнено снова. Изменения, сохранённые для ПК, применяются в его открытом окне со следующего подключения."
          }
        }
      }
    },
    "Troubleshooting" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устранение неполадок"
          }
        }
      }
    },
    "Trust and Connect" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доверять и подключиться"
          }
        }
      }
    },
    "Trust the new certificate only if you know why the server's certificate changed." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доверяйте новому сертификату, только если знаете, почему сертификат сервера изменился."
          }
        }
      }
    },
    "Turn on “Remember password in Keychain” to store the password securely. A password typed without remembering is kept in memory only until you quit." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Запомнить пароль в Связке ключей», чтобы надёжно сохранить пароль. Пароль, введённый без запоминания, хранится только в памяти до выхода из приложения."
          }
        }
      }
    },
    "Untrusted Certificate" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недоверенный сертификат"
          }
        }
      }
    },
    "Use different credentials…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать другие учётные данные…"
          }
        }
      }
    },
    "Username" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя пользователя"
          }
        }
      }
    },
    "With Match Window Size on, as it is by default, the remote desktop follows the window: resize the window and the desktop re-fits a moment later. Turn it off in the ⋯ or Session menu to keep the desktop's size, scaled to fit the window; turning it back on fits the desktop to the window again. Full screen works as a primary full-screen window." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включён параметр «По размеру окна» (по умолчанию он включён), удалённый рабочий стол следует за окном: измените размер окна, и через мгновение рабочий стол подстроится. Выключите его в меню «⋯» или «Сеанс», чтобы сохранить размер рабочего стола и масштабировать его по окну; при повторном включении рабочий стол снова подстраивается под окно. Полноэкранный режим работает как основное полноэкранное окно."
          }
        }
      }
    },
    "With “%@” on, a PC connects without asking when neither this Mac nor RDPeek trusts the certificate, and sends your credentials. Anyone able to intercept the connection could pose as the server and capture them. A certificate that replaced one you trusted is still refused." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включён параметр «%@», ПК подключается без запроса, когда ни этот Mac, ни RDPeek не доверяют сертификату, и отправляет ваши учётные данные. Любой, кто может перехватить соединение, способен выдать себя за сервер и получить их. Сертификат, заменивший доверенный вами, по-прежнему отклоняется."
          }
        }
      }
    },
    "You signed out of the remote computer." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы вышли из учётной записи на удалённом компьютере."
          }
        }
      }
    },
    "Your Data" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные"
          }
        }
      }
    },
    "hostname or IP address" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "имя хоста или IP-адрес"
          }
        }
      }
    },
    "macOS did not allow the connection to “%@”. A firewall or network filter may block it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не разрешила подключение к «%@». Возможно, его блокирует брандмауэр или сетевой фильтр."
          }
        }
      }
    },
    "rdpeek.com" : {
      "shouldTranslate" : false
    },
    "“%@” did not answer as a Remote Desktop server; check the host and port." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» не ответил как сервер удалённого рабочего стола; проверьте хост и порт."
          }
        }
      }
    },
    "“%@” did not answer. Check the host name and port, and that no firewall blocks the connection." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» не отвечает. Проверьте имя хоста и порт, а также что подключение не блокирует брандмауэр."
          }
        }
      }
    },
    "“%@” passed the session on to a server that did not answer as a Remote Desktop server." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» передал сеанс серверу, который не ответил как сервер удалённого рабочего стола."
          }
        }
      }
    },
    "“%@” passed the session on to a server that signs in with CredSSP %lld, an outdated version of Network Level Authentication that RDPeek refuses before sending it any password." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» передал сеанс серверу, который выполняет вход через CredSSP %2$lld — устаревшую версию Network Level Authentication, которую RDPeek отклоняет до отправки ему любого пароля."
          }
        }
      }
    },
    "“%@” passed the session on to a server that stopped answering before the connection was set up." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» передал сеанс серверу, который перестал отвечать до установки подключения."
          }
        }
      }
    },
    "“%@” passed the session on to a server that this Mac could not find." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» передал сеанс серверу, который этот Mac не смог найти."
          }
        }
      }
    },
    "“%@” passed the session on to a server that this Mac could not reach." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» передал сеанс серверу, к которому этот Mac не смог подключиться."
          }
        }
      }
    },
    "“%@” passed the session on to a server that this Mac could not set up a secure connection with." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» передал сеанс серверу, с которым этот Mac не смог установить защищённое подключение."
          }
        }
      }
    },
    "“%@” passed the session on to “%@”, which did not answer as a Remote Desktop server." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» передал сеанс серверу «%2$@», который не ответил как сервер удалённого рабочего стола."
          }
        }
      }
    },
    "“%@” passed the session on to “%@”, which signs in with CredSSP %lld, an outdated version of Network Level Authentication that RDPeek refuses before sending it any password." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» передал сеанс серверу «%2$@», который выполняет вход через CredSSP %3$lld — устаревшую версию Network Level Authentication, которую RDPeek отклоняет до отправки ему любого пароля."
          }
        }
      }
    },
    "“%@” passed the session on to “%@”, which stopped answering before the connection was set up." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» передал сеанс серверу «%2$@», который перестал отвечать до установки подключения."
          }
        }
      }
    },
    "“%@” passed the session on to “%@”, which this Mac could not find." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» передал сеанс серверу «%2$@», который этот Mac не смог найти."
          }
        }
      }
    },
    "“%@” passed the session on to “%@”, which this Mac could not reach." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» передал сеанс серверу «%2$@», к которому этот Mac не смог подключиться."
          }
        }
      }
    },
    "“%@” passed the session on to “%@”, which this Mac could not set up a secure connection with." : {
