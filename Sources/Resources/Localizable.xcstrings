          }
        }
      }
    },
    "Could not find “%@”. Check the host name." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось найти «%@». Проверьте имя хоста."
          }
        }
      }
    },
    "Could not reach “%@”. Check that it is on and accepts Remote Desktop connections." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к «%@». Проверьте, что он включён и принимает подключения удалённого рабочего стола."
          }
        }
      }
    },
    "Could not reach “%@”. Check that it is on. If it is on your local network, allow RDPeek in System Settings → Privacy & Security → Local Network." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к «%@». Проверьте, что он включён. Если он находится в вашей локальной сети, разрешите RDPeek в Системных настройках → Конфиденциальность и безопасность → Локальная сеть."
          }
        }
      }
    },
