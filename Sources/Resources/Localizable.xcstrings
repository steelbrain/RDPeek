    "Port must be a number between 1 and 65535." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El puerto debe ser un número entre 1 y 65535."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le port doit être un nombre compris entre 1 et 65535."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La porta deve essere un numero compreso tra 1 e 65535."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポートには1から65535までの数値を入力してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
