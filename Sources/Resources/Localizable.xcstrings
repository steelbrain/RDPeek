    "%@ is larger than the remote computer accepts; remote clipboard cleared" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supera el tamaño que acepta el ordenador remoto; se ha vaciado el portapapeles remoto"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dépasse la taille acceptée par l’ordinateur distant ; presse-papiers distant vidé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ supera le dimensioni accettate dal computer remoto; appunti remoti svuotati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はリモートコンピュータが受け付けるサイズを超えているため、リモートのクリップボードを消去しました"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é maior do que o computador remoto aceita; a área de transferência remota foi limpa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл «%@» больше, чем принимает удалённый компьютер; удалённый буфер обмена очищен"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”超出了远程计算机可接受的大小；已清除远程剪贴板"
          }
        }
      }
    },
