            "state" : "translated",
            "value" : "已在远程计算机上粘贴 1 个文件"
          }
        }
      }
    },
    "1 file shared to remote" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 archivo compartido con el ordenador remoto"
          }
        },
        "fr" : {
          "stringUnit" : {
