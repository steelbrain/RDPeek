    },
    "Trust and Connect" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiar y conectar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faire confiance et se connecter"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Considera attendibile e connetti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼して接続"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiar e Conectar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доверять и подключиться"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信任并连接"
          }
        }
      }
    },
    "Trust the new certificate only if you know why the server's certificate changed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confía en el nuevo certificado solo si sabes por qué ha cambiado el certificado del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne faites confiance au nouveau certificat que si vous savez pourquoi le certificat du serveur a changé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Considera attendibile il nuovo certificato solo se sai perché il certificato del server è cambiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバの証明書が変更された理由がわかっている場合にのみ、新しい証明書を信頼してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confie no novo certificado somente se você souber por que o certificado do servidor mudou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доверяйте новому сертификату, только если знаете, почему сертификат сервера изменился."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当你知道服务器的证书为何更改时，才信任新证书。"
          }
        }
      }
    },
    "Turn on “Remember password in Keychain” to store the password securely. A password typed without remembering is kept in memory only until you quit." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa “Recordar contraseña en el llavero” para guardar la contraseña de forma segura. Una contraseña escrita sin recordarla se conserva en la memoria solo hasta que salgas de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Mémoriser le mot de passe dans le trousseau » pour stocker le mot de passe de manière sécurisée. Un mot de passe saisi sans être mémorisé n’est conservé en mémoire que jusqu’à ce que vous quittiez l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva “Ricorda password nel portachiavi” per archiviare la password in modo sicuro. Una password inserita senza ricordarla viene conservata in memoria solo finché non esci da RDPeek."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードを安全に保管するには、「パスワードをキーチェーンに記憶」をオンにします。記憶せずに入力したパスワードは、RDPeekを終了するまでメモリ内にのみ保持されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative “Lembrar senha nas Chaves” para armazenar a senha com segurança. Uma senha digitada sem ser lembrada fica na memória somente até você encerrar o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Запомнить пароль в Связке ключей», чтобы надёжно сохранить пароль. Пароль, введённый без запоминания, хранится только в памяти до выхода из приложения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开“在钥匙串中记住密码”以安全地存储密码。未选择记住时，输入的密码只会保留在内存中，直到你退出为止。"
          }
        }
      }
    },
