          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端口必须是 1 到 65535 之间的数字。"
          }
        }
      }
    },
    "Press ⌘N or click Add PC. Only the host is required — name, credentials, clipboard, and audio are optional and editable later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa ⌘N o haz clic en “Añadir PC”. Solo es obligatorio el host; el nombre, las credenciales, el portapapeles y el audio son opcionales y se pueden editar más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur ⌘N ou cliquez sur « Ajouter un PC ». Seul l’hôte est obligatoire — le nom, les identifiants, le presse-papiers et l’audio sont facultatifs et modifiables plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi ⌘N o fai clic su “Aggiungi PC”. È obbligatorio solo l’host: nome, credenziali, appunti e audio sono facoltativi e modificabili in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘Nを押すか、「PCを追加」をクリックします。必須なのはホストのみで、名前、資格情報、クリップボード、オーディオは任意で、あとから編集できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione ⌘N ou clique em Adicionar PC. Somente o host é obrigatório — nome, credenciais, área de transferência e áudio são opcionais e podem ser editados depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите ⌘N или «Добавить ПК». Обязателен только хост — имя, учётные данные, буфер обмена и звук необязательны, и их можно изменить позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下 ⌘N 或点按“添加电脑”。只有主机为必填项；名称、凭证、剪贴板和音频均为可选项，以后也可以编辑。"
          }
        }
      }
    },
