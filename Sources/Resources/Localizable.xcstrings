    "Keychain asks for access — choose Always Allow to skip the prompt on future connections." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El llavero solicita acceso: elige “Permitir siempre” para omitir la solicitud en futuras conexiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trousseau demande l’accès — choisissez « Toujours autoriser » pour ne plus voir cette demande lors des prochaines connexions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il portachiavi chiede l’accesso — scegli “Consenti sempre” per evitare la richiesta nelle connessioni future."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーチェーンがアクセスを求める場合：「常に許可」を選択すると、次回以降の接続ではダイアログが表示されなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As Chaves pedem acesso — escolha Sempre Permitir para não ver o pedido nas próximas conexões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Связка ключей запрашивает доступ — выберите «Всегда разрешать», чтобы не видеть запрос при следующих подключениях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钥匙串请求访问权限：请选择“始终允许”，以便以后连接时跳过此提示。"
          }
        }
      }
    },
