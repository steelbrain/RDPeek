    "Enter a password to remember, or turn off “Remember password in Keychain”." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una contraseña para recordarla o desactiva “Recordar contraseña en el llavero”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un mot de passe à mémoriser, ou désactivez « Mémoriser le mot de passe dans le trousseau »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci una password da ricordare oppure disattiva “Ricorda password nel portachiavi”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記憶するパスワードを入力するか、「パスワードをキーチェーンに記憶」をオフにしてください。"
