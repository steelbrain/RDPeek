    "“%@” passed the session on to a server that signs in with CredSSP %lld, an outdated version of Network Level Authentication that RDPeek refuses before sending it any password." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ha transferido la sesión a un servidor que usa para el inicio de sesión CredSSP %lld, una versión obsoleta de la autenticación a nivel de red que RDPeek rechaza antes de enviarle ninguna contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a transmis la session à un serveur qui procède à l’identification avec CredSSP %lld, une version obsolète de l’authentification au niveau du réseau que RDPeek refuse avant de lui envoyer le moindre mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ha trasferito la sessione a un server che esegue l’accesso con CredSSP %lld, una versione obsoleta di Autenticazione a livello di rete che RDPeek rifiuta prima di inviargli qualsiasi password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」がセッションを引き渡したサーバはCredSSP %lldでサインインします。これは古いバージョンのネットワークレベル認証であるため、RDPeekはパスワードを送信する前に拒否します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” repassou a sessão para um servidor cujo início de sessão usa o CredSSP %lld, uma versão desatualizada da Autenticação no Nível da Rede que o RDPeek recusa antes de enviar qualquer senha a ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» передал сеанс серверу, который выполняет вход через CredSSP %2$lld — устаревшую версию Network Level Authentication, которую RDPeek отклоняет до отправки ему любого пароля."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将会话转交给了一台使用 CredSSP %lld 登录的服务器，这是网络级别身份验证的过时版本，RDPeek 会在向其发送任何密码之前拒绝它。"
          }
        }
      }
    },
