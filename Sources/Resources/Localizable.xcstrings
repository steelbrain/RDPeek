    "Could not reach “%@”. Check that it is on and accepts Remote Desktop connections." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido contactar con “%@”. Comprueba que esté encendido y que acepte conexiones de Escritorio remoto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre « %@ ». Vérifiez qu’il est allumé et qu’il accepte les connexions Bureau à distance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere “%@”. Verifica che sia acceso e che accetti connessioni Desktop remoto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」に到達できませんでした。電源が入っていて、リモートデスクトップ接続を受け付けていることを確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar “%@”. Verifique se está ligado e se aceita conexões de Área de Trabalho Remota."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к «%@». Проверьте, что он включён и принимает подключения удалённого рабочего стола."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问“%@”。请检查它是否已开机并接受远程桌面连接。"
          }
        }
      }
    },
    "Could not reach “%@”. Check that it is on. If it is on your local network, allow RDPeek in System Settings → Privacy & Security → Local Network." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido contactar con “%@”. Comprueba que esté encendido. Si está en tu red local, activa RDPeek en Ajustes del Sistema → Privacidad y seguridad → Red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre « %@ ». Vérifiez qu’il est allumé. S’il se trouve sur votre réseau local, autorisez RDPeek dans Réglages Système → Confidentialité et sécurité → Réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere “%@”. Verifica che sia acceso. Se si trova sulla tua rete locale, autorizza RDPeek in Impostazioni di Sistema → Privacy e sicurezza → Rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」に到達できませんでした。電源が入っていることを確認してください。ローカルネットワーク上にある場合は、「システム設定」→「プライバシーとセキュリティ」→「ローカルネットワーク」でRDPeekを許可してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível acessar “%@”. Verifique se está ligado. Se estiver na sua rede local, permita o RDPeek em Ajustes do Sistema → Privacidade e Segurança → Rede Local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подключиться к «%@». Проверьте, что он включён. Если он находится в вашей локальной сети, разрешите RDPeek в Системных настройках → Конфиденциальность и безопасность → Локальная сеть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问“%@”。请检查它是否已开机。如果它位于你的本地网络上，请在“系统设置”→“隐私与安全性”→“本地网络”中允许 RDPeek。"
          }
        }
      }
    },
