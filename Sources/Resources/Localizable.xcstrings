    "RDPeek cannot send these settings to the remote computer. Check that the user name, domain and password are not too long." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RDPeek no puede enviar estos ajustes al ordenador remoto. Comprueba que el nombre de usuario, el dominio y la contraseña no sean demasiado largos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RDPeek ne peut pas envoyer ces réglages à l’ordinateur distant. Vérifiez que le nom d’utilisateur, le domaine et le mot de passe ne sont pas trop longs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RDPeek non può inviare queste impostazioni al computer remoto. Verifica che nome utente, dominio e password non siano troppo lunghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RDPeekはこれらの設定をリモートコンピュータに送信できません。ユーザ名、ドメイン、パスワードが長すぎないことを確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O RDPeek não pode enviar estes ajustes ao computador remoto. Verifique se o nome de usuário, o domínio e a senha não são longos demais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RDPeek не может отправить эти настройки на удалённый компьютер. Проверьте, что имя пользователя, домен и пароль не слишком длинные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RDPeek 无法将这些设置发送到远程计算机。请检查用户名、域和密码是否过长。"
          }
        }
      }
    },
