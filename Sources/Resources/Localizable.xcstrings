{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is larger than the remote computer accepts; remote clipboard cleared" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл «%@» больше, чем принимает удалённый компьютер; удалённый буфер обмена очищен"
          }
        }
      }
    },
    "%lld files pasted on remote" : {
