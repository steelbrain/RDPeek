    "Choppy video — open Stats for Nerds or the performance overlay from the ⋯ menu to see fps, decode times, and bandwidth." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo va a saltos: abre “Estadísticas para nerds” o la superposición de rendimiento desde el menú ⋯ para ver los fps, los tiempos de decodificación y el ancho de banda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidéo saccadée — ouvrez « Statistiques pour les geeks » ou la superposition des performances depuis le menu ⋯ pour voir les fps, les temps de décodage et la bande passante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video a scatti — apri “Statistiche per nerd” o l’overlay delle prestazioni dal menu ⋯ per vedere fps, tempi di decodifica e larghezza di banda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映像がカクつく場合：⋯メニューから「詳細統計情報」またはパフォーマンスオーバーレイを開くと、fps、デコード時間、帯域幅を確認できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vídeo travando — abra Estatísticas para Nerds ou a sobreposição de desempenho no menu ⋯ para ver fps, tempos de decodificação e largura de banda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прерывистое видео — откройте «Статистику для гиков» или индикатор производительности в меню «⋯», чтобы увидеть частоту кадров, время декодирования и пропускную способность."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频卡顿：从 ⋯ 菜单打开“详细统计信息”或性能叠加层，查看 fps、解码时间和带宽。"
          }
        }
      }
    },
